<rkr.simplekeyboard.inputmethod.latin.InputView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="?attr/inputViewStyle">
    <!-- Everything the user can see and touch: the secure-mode bar, the draft being written in
         secure mode and the keys. Its height is what the IME reports as its insets. -->
    <LinearLayout
        android:id="@+id/keyboard_frame"
        android:orientation="vertical"
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include layout="@layout/cifra_bar" />
        <include layout="@layout/cifra_compose" />
        <FrameLayout
            android:id="@+id/keyboard_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <rkr.simplekeyboard.inputmethod.keyboard.MainKeyboardView
                android:id="@+id/keyboard_view"
                android:layoutDirection="ltr"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <!-- Covers the keys with the same height for pickers, previews and decrypted
                 messages, so the app below does not jump. -->
            <include layout="@layout/cifra_overlay" />
        </FrameLayout>
    </LinearLayout>
</rkr.simplekeyboard.inputmethod.latin.InputView>
