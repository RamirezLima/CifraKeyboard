<?xml version="1.0" encoding="utf-8"?>
<!-- Camera preview with the instructions on top. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <TextureView
        android:id="@+id/cifra_qr_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_gravity="center"
        android:background="@drawable/cifra_qr_frame" />

    <LinearLayout
        android:id="@+id/cifra_qr_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/cifra_qr_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:shadowColor="#FF000000"
            android:shadowRadius="4"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cifra_qr_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/cifra_alert_background"
            android:padding="10dp"
            android:text="@string/cifra_qr_online_warning"
            android:textColor="@color/cifra_on_accent"
            android:textSize="14sp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/cifra_qr_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#99000000"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/cifra_qr_scan_hint"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />

        <Button
            android:id="@+id/cifra_qr_close"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@android:string/cancel" />
    </LinearLayout>
</FrameLayout>
